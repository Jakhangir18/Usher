# Copy to .env (next to server.py) and fill in. .env is gitignored; never commit keys.

USER_NAME=Jax
# Whisper spellings of the name (also used for the HUD's "name mentioned" message).
USER_NAME_ALIASES=jacks,jaxx

# Wake phrase = greeting + name. Only this triggers the motors/display.
WAKE_GREETINGS=hello,helo,hallo,hullo,hi,hey,hiya
WAKE_MAX_GAP=1
# Extra spellings accepted ONLY right after a greeting ("hello jack" is Whisper's likeliest spelling).
WAKE_EXTRA_NAMES=jack
# Must be longer than WAKE_WINDOW_SEC so one phrase isn't announced twice.
WAKE_COOLDOWN_SEC=4.5

# Rolling wake window: every hop, transcribe the last WAKE_WINDOW_SEC (if any of it was loud).
WAKE_WINDOW_SEC=4.0
WAKE_HOP_SEC=1.0

# Mic input. The XVF3800 is ALSA card 2 with 6 channels. Use one channel, never the mix (echoey).
# ch2 = single raw mic (clean, quieter). ch0 = processed beam (noise reduction, but clipped in our test).
AUDIO_DEVICE=XVF3800
AUDIO_INPUT_CHANNELS=6
AUDIO_CHANNEL=2
# A window is transcribed only if some 0.1 s of it reaches this RMS. Set a bit above the room's
# background, using the "listening… peak=" log lines (room was ~0.008-0.0115 in testing).
VOLUME_THRESHOLD=0.015

# Path to the reSpeaker xvf_host tool. Default: ~/Documents/reSpeaker_XVF3800_USB_4MIC_ARRAY/host_control/rpi_64bit/xvf_host
# Only set this if yours is elsewhere, and use a full path (~ isn't expanded here).
# XVF_HOST=/home/<user>/Documents/reSpeaker_XVF3800_USB_4MIC_ARRAY/host_control/rpi_64bit/xvf_host
# Direction source: auto = USB DOA_VALUE (angle + on-chip speech flag), falling back to xvf_host.
DOA_SOURCE=auto
DOA_POLL_SEC=0.05

# Mic orientation. Get both values from `python doa_calibrate.py` with the mic mounted on the headset.
# Values below were measured 2026-10-03 with the OLD xvf_host source; recalibrate for the USB source.
# Wearer's front = side of the mic board AWAY from the USB plug.
DOA_FLIP_LEFT_RIGHT=1
DOA_OFFSET_DEG=181

# Speed: greedy decoding. Speech filtering via Whisper's built-in VAD (onnxruntime) instead of the
# separate torch Silero gate: with the rolling window, Silero + Whisper stalled the loop on the Pi.
WHISPER_BEAM_SIZE=1
USE_SILERO_VAD=0
WHISPER_VAD_FILTER=1

# Leave empty for now; Gemini is only for names/context later, never the buzz.
GEMINI_API_KEY=

# ElevenLabs (planned: Scribe captions, TTS replies; not read by any code yet). Real key only in .env, never here.
ELEVENLABS_API_KEY=
