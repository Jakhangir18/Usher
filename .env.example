# Copy to .env (next to server.py) and fill in. .env is gitignored; never commit keys.

USER_NAME=Jax
# Whisper spellings of the name (also used for the HUD's "name mentioned" message).
USER_NAME_ALIASES=jacks,jaxx

# Wake phrase = greeting + name. Only this triggers the motors/display.
WAKE_GREETINGS=hello,helo,hallo,hullo,hi,hey,hiya
WAKE_MAX_GAP=1
# Extra spellings accepted ONLY right after a greeting ("hello jack" is Whisper's likeliest spelling).
WAKE_EXTRA_NAMES=jack
# Must be longer than WAKE_WINDOW_SEC so one phrase isn't announced twice.
WAKE_COOLDOWN_SEC=4.5

# Rolling wake window: every hop, transcribe the last WAKE_WINDOW_SEC (if any of it was loud).
WAKE_WINDOW_SEC=4.0
# 1 = print Whisper's rough wake-check transcripts (never shown on the display; captions are ElevenLabs).
WAKE_LOG=0
WAKE_HOP_SEC=1.0

# Mic input. The XVF3800 is ALSA card 2 with 6 channels. Use one channel, never the mix (echoey).
# ch2 = single raw mic (clean, quieter). ch0 = processed beam (noise reduction, but clipped in our test).
AUDIO_DEVICE=XVF3800
AUDIO_INPUT_CHANNELS=6
AUDIO_CHANNEL=2
# A window is transcribed only if some 0.1 s of it reaches this RMS. Set a bit above the room's
# background, using the "listening… peak=" log lines (room was ~0.008-0.0115 in testing).
VOLUME_THRESHOLD=0.015

# Path to the reSpeaker xvf_host tool. Default: ~/Documents/reSpeaker_XVF3800_USB_4MIC_ARRAY/host_control/rpi_64bit/xvf_host
# Only set this if yours is elsewhere, and use a full path (~ isn't expanded here).
# XVF_HOST=/home/<user>/Documents/reSpeaker_XVF3800_USB_4MIC_ARRAY/host_control/rpi_64bit/xvf_host
# Direction source: auto = USB DOA_VALUE (angle + on-chip speech flag), falling back to xvf_host.
DOA_SOURCE=auto
DOA_POLL_SEC=0.05

# Mic orientation. Get both values from `python doa_calibrate.py` with the mic mounted on the headset.
# Measured 2026-10-03 with the USB DOA_VALUE source (residual error 3-11 deg).
# Wearer's front = side of the mic board AWAY from the USB plug.
DOA_FLIP_LEFT_RIGHT=1
DOA_OFFSET_DEG=184

# Speed: greedy decoding. Speech filtering via Whisper's built-in VAD (onnxruntime) instead of the
# separate torch Silero gate: with the rolling window, Silero + Whisper stalled the loop on the Pi.
WHISPER_BEAM_SIZE=1
USE_SILERO_VAD=0
WHISPER_VAD_FILTER=1

# Gemini (aistudio.google.com): names from context + conversation summary for the web app, every
# GEMINI_SUMMARY_SEC when there are new captions. Background only, never the buzz. Empty = off.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_SUMMARY_SEC=12

# ElevenLabs Scribe: "catch me up" in server.py, plus scribe_test.py / live_captions.py.
# Real key only in .env, never here. Without a key, catch-up is simply off.
ELEVENLABS_API_KEY=
# On each "Hello Jax", send the last CATCHUP_SEC to Scribe and show the caller's last CATCHUP_WORDS words (0 = off).
CATCHUP_SEC=30
CATCHUP_WORDS=45
# Live captions run inside server.py alongside "Hello Jax" (1 = on, needs the key above).
LIVE_CAPTIONS=1
# Captions read the chip's processed beam (ch0): clearer nearby voices vs background than ch2.
CAPTION_AUDIO_CHANNEL=0
CAPTION_MIN_RMS=0.02
# Option B (0): no speaker tags in the live text, only "who is talking now". 1 = inverted tags.
LIVE_SPEAKER_TAGS=0
# Web app "ideal version": voice-identified lines from batch Scribe ~1-2 s after each sentence,
# replacing the faint live text. Only runs while the web app is open (billed per audio second sent).
# REFINE_MIN_RMS: quieter turns (ch2) are dropped as distant chatter; lower it if real speech goes missing.
REFINE_CAPTIONS=1
REFINE_WINDOW_SEC=20
REFINE_MIN_RMS=0.005
# Most voices it will tell apart; past this, an unknown voice joins the one from the nearest direction.
# Set to the people at the table plus a couple (first test: 4 people became 16 voices before this).
REFINE_MAX_VOICES=6
